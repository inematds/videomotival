# Configuração NÃO secreta do videomotival. Copie para .env e ajuste.
# Segredos (OPENROUTER_API_KEY, GROQ_API_KEY, FISH_API_KEY) NÃO vão aqui:
# são lidos em runtime de ~/projetos/openpcbotv2/.env e ~/projetos/wifi/.env.

# Onde as corridas são gravadas
OUTPUT_ROOT=~/projetos/output/videomotival

# História
STORY_PROVIDER=auto            # auto | openrouter | groq | ollama | manual
STORY_LANG=pt
WORDS_PER_MINUTE=140           # sobrescrito pelo calibration.json depois da 1ª corrida
OPENROUTER_MODEL=z-ai/glm-5.2
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b

# Voz
TTS_PROVIDER=inemavox          # inemavox | fish
TTS_ENGINE=chatterbox          # chatterbox | chatterbox-vc | edge
TTS_VOICE=rachel               # nome do .wav em VOICE_REFS_DIR, ou voz edge (pt-BR-FranciscaNeural)
VOICE_REFS_DIR=~/projetos/timesmkt3/media/voice-refs
INEMAVOX_URL=http://localhost:8010
AUDIO_PAD_SECONDS=0.45
FISH_MODEL=s2-pro
FISH_VOICE_ID=                 # só para TTS_PROVIDER=fish

# Imagens
IMAGE_PROVIDER=inemaimg
INEMAIMG_URL=http://localhost:8000
IMAGE_MODEL=flux2-klein
IMAGE_STEPS=4
IMAGE_WIDTH=1920
IMAGE_HEIGHT=1080

# Render
TITLE_OVERLAY=1                # título exato na cena 1 (Pillow + ffmpeg overlay)
TITLE_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
DURATION_GATE=warn             # warn | strict
FPS=30
